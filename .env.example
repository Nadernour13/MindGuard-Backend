# Server
PORT=4000

# Database — use sqlite for local dev (no setup needed), mssql for Azure SQL in production
DB_DIALECT=sqlite
# DB_DIALECT=mssql

# Only needed when DB_DIALECT=mssql (Azure SQL)
DB_HOST=REPLACE-ME.database.windows.net
DB_NAME=MindGuardDb
DB_USER=REPLACE-ME
DB_PASSWORD=REPLACE-ME

# JWT
JWT_SECRET=REPLACE-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARS
JWT_EXPIRES_IN=1d

# Azure Blob Storage (photos, voice notes)
AZURE_STORAGE_CONNECTION_STRING=REPLACE-ME
AZURE_STORAGE_CONTAINER=mindguard-media

# AI microservice (Python, serves Yousef's .pkl models)
AI_SERVICE_BASE_URL=http://localhost:5001
